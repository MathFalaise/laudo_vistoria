# Copie para .env e preencha. O .env NÃO vai para o repositório.

# --- Gemini ---------------------------------------------------------------
# Gerada em https://aistudio.google.com/apikey, num projeto com FATURAMENTO
# ATIVO. A camada gratuita permite ao Google usar o conteúdo enviado para
# melhorar produtos, com revisão humana — e aqui se enviam fotos do interior
# de imóveis de clientes (LGPD). Ver CLAUDE.md.
# Esta chave fica só no servidor: o navegador nunca a recebe.
GEMINI_API_KEY=

# --- provedores de modelo (opcional) -------------------------------------
# Quem analisa as fotos: gemini (padrão), glm ou claude. Trocar o modelo que
# gera os laudos exige teste real de ponta a ponta antes (CLAUDE.md), e mandar
# fotos de cliente a um provedor novo é decisão sua (LGPD): confira a política
# de dados do provedor antes de preencher a chave.
VISION_PROVIDER=gemini
# Se o analista falhar (rede, 5xx, recusa), repete a MESMA chamada neste.
# Vazio = sem reserva (padrão).
VISION_FALLBACK_PROVIDER=

# GLM-5.3-Flash pelo OpenCode Zen (gateway; o modelo não roda localmente).
# Chave em opencode.ai. O Zen declara retenção zero e não treinar com os
# dados, exceto em modelos gratuitos — este é pago (US$ 0,15/0,50 por milhão
# de tokens em 05/10/2026). Confira na documentação antes de usar.
GLM_API_KEY=
GLM_BASE_URL=https://opencode.ai/zen/v1
GLM_MODEL=glm-5.3-flash
# json_schema (padrão) ou json_object, se o gateway recusar o JSON Schema.
GLM_FORMATO_RESPOSTA=json_schema
# Parâmetros extras do corpo do pedido, em JSON (ex.: desligar raciocínio).
GLM_PARAMETROS_EXTRA=

# Claude (API da Anthropic), usado como VALIDADOR visual. O modelo é
# obrigatório e nenhum fica fixo no código.
CLAUDE_API_KEY=
CLAUDE_MODEL=

# --- validação visual seletiva (só no motor de evidências) ----------------
# 1 liga: as evidências duvidosas (critérios em core/config.py, nunca no
# prompt) são conferidas olhando a foto de novo. O validador não escreve
# laudo, só confirma, corrige ou tira — quem decide é o código.
VALIDATION_ENABLED=0
VALIDATOR_PROVIDER=claude
# selective (padrão: só as duvidosas) ou all (todas as aceitas).
VALIDATION_POLICY=selective
# Se a validação falhar: pendencia (padrão: o item não entra sem conferência)
# ou manter (segue como o escopo decidiu). Falha nunca vira aprovação.
VALIDATION_FAILURE_POLICY=pendencia
# Correção do validador: aplicar (padrão: atualiza a evidência e guarda a
# original) ou conflito (os dois lados vão para você decidir).
VALIDATION_CORRECTED_POLICY=aplicar
# Reanálises dirigidas por evidência (teto 1, em core/config.py).
MAX_REANALISES=1

# --- custo ----------------------------------------------------------------
# Preço por milhão de tokens dos modelos que não estão em
# core/config.PRECOS_POR_MILHAO, em JSON: {"modelo": [entrada, saida]}.
# Sem preço, o custo aparece como desconhecido — nunca como zero.
LAUDO_PRECOS_MODELOS=

# --- primeiro acesso ------------------------------------------------------
# Criam o usuário inicial na primeira subida, se o banco estiver vazio.
# A senha precisa ter pelo menos 10 caracteres, senão o usuário não é criado.
LAUDO_ADMIN_EMAIL=voce@exemplo.com
LAUDO_ADMIN_SENHA=

# --- sessão ---------------------------------------------------------------
LAUDO_SESSAO_HORAS=12
# Ponha 1 assim que a aplicação estiver atrás de HTTPS. Com isso o cookie de
# sessão deixa de trafegar em conexão não cifrada.
LAUDO_COOKIE_SEGURO=0

# --- limites de upload ----------------------------------------------------
LAUDO_MAX_FOTO_MB=25
LAUDO_MAX_ZIP_MB=500
LAUDO_MAX_ARQUIVOS_ZIP=3000
LAUDO_MAX_DESCOMPACTADO_MB=2000

# --- motor ----------------------------------------------------------------
# 1 liga o motor de evidências também no CLI (na web ele é o padrão da tela).
LAUDO_MOTOR_EVIDENCIAS=0

# --- diversos -------------------------------------------------------------
# Vazio em produção (a API serve o frontend na mesma origem). Em
# desenvolvimento, com o Vite em 5173, use o padrão do config.py.
LAUDO_ORIGENS=
# 1 publica /docs com o esquema da API. Deixe desligado em produção.
LAUDO_DOCS=0
LAUDO_LOG=INFO
