# Copie para .env e preencha. O .env NÃO vai para o repositório.

# --- Gemini ---------------------------------------------------------------
# Gerada em https://aistudio.google.com/apikey, num projeto com FATURAMENTO
# ATIVO. A camada gratuita permite ao Google usar o conteúdo enviado para
# melhorar produtos, com revisão humana — e aqui se enviam fotos do interior
# de imóveis de clientes (LGPD). Ver CLAUDE.md.
# Esta chave fica só no servidor: o navegador nunca a recebe.
GEMINI_API_KEY=

# --- primeiro acesso ------------------------------------------------------
# Criam o usuário inicial na primeira subida, se o banco estiver vazio.
# A senha precisa ter pelo menos 10 caracteres, senão o usuário não é criado.
LAUDO_ADMIN_EMAIL=voce@exemplo.com
LAUDO_ADMIN_SENHA=

# --- sessão ---------------------------------------------------------------
LAUDO_SESSAO_HORAS=12
# Ponha 1 assim que a aplicação estiver atrás de HTTPS. Com isso o cookie de
# sessão deixa de trafegar em conexão não cifrada.
LAUDO_COOKIE_SEGURO=0

# --- limites de upload ----------------------------------------------------
LAUDO_MAX_FOTO_MB=25
LAUDO_MAX_ZIP_MB=500
LAUDO_MAX_ARQUIVOS_ZIP=3000
LAUDO_MAX_DESCOMPACTADO_MB=2000

# --- motor ----------------------------------------------------------------
# 1 liga o motor de evidências também no CLI (na web ele é o padrão da tela).
LAUDO_MOTOR_EVIDENCIAS=0

# --- diversos -------------------------------------------------------------
# Vazio em produção (a API serve o frontend na mesma origem). Em
# desenvolvimento, com o Vite em 5173, use o padrão do config.py.
LAUDO_ORIGENS=
# 1 publica /docs com o esquema da API. Deixe desligado em produção.
LAUDO_DOCS=0
LAUDO_LOG=INFO
